generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTIDADE / ACESSO
// ---------------------------------------------------------------------------
enum Papel {
  COMERCIAL
  ADMINISTRATIVO
  FINANCEIRO
  DIRETORIA
  ADMIN
  CLIENTE_PORTAL 
}

model Usuario {
  id                 String          @id @default(cuid())
  nome               String
  email              String          @unique
  papel              Papel
  ativo              Boolean         @default(true)
  criadoEm           DateTime        @default(now())

  processosCriados   Processo[]      @relation("ProcessoCriadoPor")
  etapasResponsavel  ProcessoEtapa[] @relation("EtapaResponsavel")
  documentosEnviados Documento[]     @relation("DocumentoUploadedBy")
  mensagens          ChatMessage[]
  logs               AuditLog[]
  custosAtualizados  CustoItem[]
}

// ---------------------------------------------------------------------------
// PARCEIROS EXTERNOS
// ---------------------------------------------------------------------------
enum TipoParceiro {
  GERENCIADORA_RISCO 
  AGENTE_DESPACHANTE  
  AGENTE_BOOKING      
  INSPETORIA          
  SURVEY_FUMIGACAO    
  TRANSPORTADORA
  SEGURADORA          
  BANCO               
  TRANSPORTADORA_INTL 
  OUTRO
}

model Parceiro {
  id             String          @id @default(cuid())
  nome           String
  tipo           TipoParceiro
  contato        String?
  ativo          Boolean         @default(true)

  etapaTemplates EtapaTemplate[]
  documentos     Documento[]
}

// ---------------------------------------------------------------------------
// FASES E ETAPAS
// ---------------------------------------------------------------------------
enum Fase {
  COMERCIAL
  PRODUTOR_VENDEDOR
  ADMINISTRATIVO
  INDUSTRIA_BENEFICIAMENTO
  BOOKING_TRANSPORTE
  CARREGAMENTO
  CARREGAMENTO_REDEX
  DOCUMENTACAO_EXPORTACAO
  TERMINAL_PORTO
  FECHAMENTO_BANCARIO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  BLOQUEADA  
  NAO_APLICAVEL
}

enum NivelAutomacao {
  MANUAL
  N8N_SIMPLES
  API_RPA_FASE2
}

model EtapaTemplate {
  id                String          @id @default(cuid())
  numero            String          @unique
  ordem             Int             
  fase              Fase
  etapa             String          
  raiaResponsavel   String          
  parceiroId        String?
  parceiro          Parceiro?       @relation(fields: [parceiroId], references: [id])
  canal             String?         
  gatilho           String?         
  entrada           String?         
  saida             String?         
  ehDecisao         Boolean         @default(false) 
  automacaoSugerida NivelAutomacao  @default(MANUAL)
  geraDocumento     Boolean         @default(false)
  tipoDocumentoId   String?
  tipoDocumento     TipoDocumento?  @relation(fields: [tipoDocumentoId], references: [id])

  instancias        ProcessoEtapa[]
}

model ProcessoEtapa {
  id              String        @id @default(cuid())
  processoId      String
  processo        Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  etapaTemplateId String
  etapaTemplate   EtapaTemplate @relation(fields: [etapaTemplateId], references: [id])
  status          StatusEtapa   @default(PENDENTE)
  responsavelId   String?
  responsavel     Usuario?      @relation("EtapaResponsavel", fields: [responsavelId], references: [id])
  observacao      String?
  iniciadoEm      DateTime?
  concluidoEm     DateTime?

  documentos      Documento[]

  @@unique([processoId, etapaTemplateId])
  @@index([processoId, status])
}

// ---------------------------------------------------------------------------
// STATUS MANUAL DA NEGOCIAÇÃO
// ---------------------------------------------------------------------------
enum StatusNegociacao {
  PENDENTE
  EM_NEGOCIACAO
  EMBARCADO
  FINALIZADO
  CANCELADO
}

// ---------------------------------------------------------------------------
// PROCESSO (NEGOCIAÇÃO)
// ---------------------------------------------------------------------------
model Processo {
  id                String    @id @default(cuid())
  numeroProcesso    String    @unique 
  clienteFinal      String
  traderIntermedio  String?
  produto           String
  volumeKg          Decimal   @db.Decimal(14, 3)
  incoterm          String
  portoDestino      String
  redex             String?
  valorDeclaradoUsd Decimal?  @db.Decimal(14, 2)

  bookingNumero     String?
  navio             String?
  deadlineEmbarque  DateTime?

  criadoPorId       String
  criadoPor         Usuario   @relation("ProcessoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  etapas            ProcessoEtapa[]
  documentos        Documento[]
  financeiro        Financeiro?
  mensagens         ChatMessage[]
  logs              AuditLog[]

  statusCache       String? 
  status            StatusNegociacao @default(PENDENTE)

  @@index([deadlineEmbarque])
  @@index([statusCache])
}

// ---------------------------------------------------------------------------
// GED — DOCUMENTOS
// ---------------------------------------------------------------------------
enum CategoriaDocumento {
  COMERCIAL
  ADMINISTRATIVO
  PRODUCAO_INDUSTRIA
  BOOKING_TRANSPORTE
  REDEX_CARREGAMENTO
  DOCUMENTACAO_EXPORTACAO
  FECHAMENTO_BANCARIO
}

model TipoDocumento {
  id                       String             @id @default(cuid())
  nome                     String             @unique
  categoria                CategoriaDocumento
  obrigatorioNoPacoteFinal Boolean            @default(false)

  etapasQueGeram           EtapaTemplate[]
  documentos               Documento[]
}

enum StatusDocumento {
  RASCUNHO
  APROVADO
  ENVIADO_CLIENTE
  ARQUIVADO
  REPROVADO
}

model Documento {
  id                String          @id @default(cuid())
  processoId        String
  processo          Processo        @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipoDocumentoId   String
  tipoDocumento     TipoDocumento   @relation(fields: [tipoDocumentoId], references: [id])
  etapaOrigemId     String?
  etapaOrigem       ProcessoEtapa?  @relation(fields: [etapaOrigemId], references: [id])
  parceiroEmissorId String?
  parceiroEmissor   Parceiro?       @relation(fields: [parceiroEmissorId], references: [id])

  nomeArquivo       String
  storagePath       String
  versao            Int             @default(1)
  status            StatusDocumento @default(RASCUNHO)

  uploadedById      String
  uploadedBy        Usuario         @relation("DocumentoUploadedBy", fields: [uploadedById], references: [id])
  uploadedEm        DateTime        @default(now())

  @@index([processoId, tipoDocumentoId])
}

// ---------------------------------------------------------------------------
// FINANCEIRO
// ---------------------------------------------------------------------------
model Financeiro {
  id           String      @id @default(cuid())
  processoId   String      @unique
  processo     Processo    @relation(fields: [processoId], references: [id], onDelete: Cascade)
  precoUsd     Decimal     @db.Decimal(12, 2)
  ptax         Decimal     @db.Decimal(8, 4)
  atualizadoEm DateTime    @updatedAt

  custos       CustoItem[]
}

enum CategoriaCusto {
  COMPRA_MATERIA_PRIMA
  BENEFICIAMENTO
  FRETE_TERRESTRE
  FRETE_MARITIMO
  TARIFA_ARMADOR_PORTO
  ESTUFAGEM_REDEX
  COMISSAO_INTERMEDIACAO
  OUTROS
}

model CustoItem {
  id              String         @id @default(cuid())
  financeiroId    String
  financeiro      Financeiro     @relation(fields: [financeiroId], references: [id], onDelete: Cascade)
  categoria       CategoriaCusto
  valor           Decimal        @db.Decimal(14, 2)
  atualizadoPorId String
  atualizadoPor   Usuario        @relation(fields: [atualizadoPorId], references: [id])
  atualizadoEm    DateTime       @updatedAt

  @@unique([financeiroId, categoria])
}

// ---------------------------------------------------------------------------
// CHAT INTERNO
// ---------------------------------------------------------------------------
model ChatMessage {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  autorId    String
  autor      Usuario  @relation(fields: [autorId], references: [id])
  texto      String
  criadoEm   DateTime @default(now())

  @@index([processoId, criadoEm])
}

// ---------------------------------------------------------------------------
// AUDITORIA
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String
  detalhe    String
  criadoEm   DateTime @default(now())

  @@index([processoId, criadoEm])
}

// ---------------------------------------------------------------------------
// LOG DE WEBHOOKS N8N
// ---------------------------------------------------------------------------
model WebhookEvent {
  id         String   @id @default(cuid())
  origem     String
  evento     String
  payload    Json
  processado Boolean  @default(false)
  erro       String?
  recebidoEm DateTime @default(now())
}