generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTIDADE / ACESSO
// ---------------------------------------------------------------------------
enum Papel {
  COMERCIAL
  ADMINISTRATIVO
  FINANCEIRO
  DIRETORIA
  ADMIN
  CLIENTE_PORTAL 
}

model Usuario {
  id                 String          @id @default(cuid())
  nome               String
  email              String          @unique
  username           String?         @unique
  senhaHash          String?
  primeiroAcesso     Boolean         @default(true)
  papel              Papel           @default(ADMIN)
  ativo              Boolean         @default(true)
  imagem             String?
  criadoEm           DateTime        @default(now())
  atualizadoEm       DateTime        @default(now()) @updatedAt

  accounts           Account[]
  sessions           Session[]

  processosCriados   Processo[]      @relation("ProcessoCriadoPor")
  etapasResponsavel  ProcessoEtapa[] @relation("EtapaResponsavel")
  documentosEnviados Documento[]     @relation("DocumentoUploadedBy")
  mensagens          ChatMessage[]
  logs               AuditLog[]
  custosAtualizados  CustoItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// PARCEIROS EXTERNOS
// ---------------------------------------------------------------------------
enum TipoParceiro {
  GERENCIADORA_RISCO 
  AGENTE_DESPACHANTE  
  AGENTE_BOOKING      
  INSPETORIA          
  SURVEY_FUMIGACAO    
  TRANSPORTADORA
  SEGURADORA          
  BANCO               
  TRANSPORTADORA_INTL 
  OUTRO
}

model Parceiro {
  id             String          @id @default(cuid())
  nome           String          @unique
  tipo           TipoParceiro
  contato        String?
  ativo          Boolean         @default(true)

  etapaTemplates EtapaTemplate[]
  documentos     Documento[]
}

// ---------------------------------------------------------------------------
// FASES E ETAPAS
// ---------------------------------------------------------------------------
enum Fase {
  COMERCIAL
  PRODUTOR_VENDEDOR
  ADMINISTRATIVO
  INDUSTRIA_BENEFICIAMENTO
  BOOKING_TRANSPORTE
  CARREGAMENTO
  CARREGAMENTO_REDEX
  DOCUMENTACAO_EXPORTACAO
  TERMINAL_PORTO
  FECHAMENTO_BANCARIO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  BLOQUEADA  
  NAO_APLICAVEL
}

enum NivelAutomacao {
  MANUAL
  N8N_SIMPLES
  API_RPA_FASE2
}

model EtapaTemplate {
  id                String          @id @default(cuid())
  numero            String          @unique
  ordem             Int             
  fase              Fase
  etapa             String          
  raiaResponsavel   String          
  parceiroId        String?
  parceiro          Parceiro?       @relation(fields: [parceiroId], references: [id])
  canal             String?         
  gatilho           String?         
  entrada           String?         
  saida             String?         
  ehDecisao         Boolean         @default(false) 
  automacaoSugerida NivelAutomacao  @default(MANUAL)
  geraDocumento     Boolean         @default(false)
  tipoDocumentoId   String?
  tipoDocumento     TipoDocumento?  @relation(fields: [tipoDocumentoId], references: [id])

  instancias        ProcessoEtapa[]
}

model ProcessoEtapa {
  id              String        @id @default(cuid())
  processoId      String
  processo        Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  etapaTemplateId String
  etapaTemplate   EtapaTemplate @relation(fields: [etapaTemplateId], references: [id])
  status          StatusEtapa   @default(PENDENTE)
  responsavelId   String?
  responsavel     Usuario?      @relation("EtapaResponsavel", fields: [responsavelId], references: [id])
  observacao      String?
  iniciadoEm      DateTime?
  concluidoEm     DateTime?

  documentos      Documento[]

  @@unique([processoId, etapaTemplateId])
  @@index([processoId, status])
}

// ---------------------------------------------------------------------------
// STATUS MANUAL DA NEGOCIAÇÃO
// ---------------------------------------------------------------------------
enum StatusNegociacao {
  PENDENTE
  EM_NEGOCIACAO
  EM_EXECUCAO
  EMBARCADO
  FINALIZADO
  CANCELADO
}

// ---------------------------------------------------------------------------
// PROCESSO (NEGOCIAÇÃO)
// ---------------------------------------------------------------------------
model Processo {
  id                String    @id @default(cuid())
  numeroProcesso    String    @unique 
  clienteFinal      String
  traderIntermedio  String?
  produto           String
  volumeKg          Decimal   @db.Decimal(14, 3)
  incoterm          String?   @default("FOB")
  portoOrigem       String?
  portoDestino      String
  redex             String?
  valorDeclaradoUsd Decimal?  @db.Decimal(14, 2)

  bookingNumero     String?
  navio             String?
  deadlineEmbarque  DateTime? // Mantido para compatibilidade histórica (antigo deadline geral)
  deadlineDraftBl   DateTime? // Deadline Envio Draft BL ao armador
  deadlineDraftVgm  DateTime? // Deadline Envio Peso Bruto Verificado (SOLAS VGM)
  deadlineCarga     DateTime? // Deadline Entrada física da carga / Gate Terminal
  dataEstufagem     DateTime?

  // --- Informações (contêiner / fumigação) ---
  localEstufagem      String?
  containerQtd        Int?
  containerTipo       String?   @default("20' DRY")
  embalagemTipo       String?   @default("Sacaria 30kg")
  sacasPorContainer   Int?
  fumigacaoNecessaria Boolean?
  fumigacaoTipo       String?
  fumigacaoTempoHoras Int?      @default(24)
  armador             String?   @default("ONE")

  // --- Características ---
  estufagemInicio     DateTime?
  estufagemFim        DateTime?
  mapaNaSequencia     Boolean?
  necessitaEtiqueta   Boolean?
  ncm                 String?

  // --- Novos campos operacionais ---
  freeTimeDestino     String?
  ruc                 String?
  contratoInterno     String?

  criadoPorId       String
  criadoPor         Usuario   @relation("ProcessoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  etapas            ProcessoEtapa[]
  documentos        Documento[]
  financeiro        Financeiro?
  mensagens         ChatMessage[]
  logs              AuditLog[]
  containers        Container[]
  notasFiscais      NotaFiscal[]

  statusCache       String? 
  status            StatusNegociacao @default(PENDENTE)

  // --- COMPRADOR / IMPORTADOR (Campos Separados) ---
  enderecoBuyer     String?
  complementoBuyer  String?
  cidadeBuyer       String?
  paisBuyer         String?
  iecBuyer          String?
  fassaiBuyer       String?
  panBuyer          String?
  gstBuyer          String?
  emailBuyer        String?
  telefoneBuyer     String?

  // --- VÍNCULOS COM CADASTRO CENTRALIZADO & RASTREABILIDADE DO GRÃO ---
  produtorId          String?
  produtor            CadastroEntidade? @relation("ProcessoProdutor", fields: [produtorId], references: [id])
  importadorId        String?
  importador          CadastroEntidade? @relation("ProcessoImportador", fields: [importadorId], references: [id])

  // Snapshot do Trajeto do Grão & Auditoria de Origem
  fazendaOrigemNome     String?
  produtorCarCache      String?
  produtorIeCache       String?
  trajetoStatus         String?           @default("FAZENDA") // FAZENDA, SILO_ORIGEM, TRANSBORDO_RODOVIARIO, TERMINAL_PORTUARIO, EMBARCADO_NAVIO, ENTREGUE_DESTINO
  siloArmazemOrigem     String?
  armazemCnpj           String?
  armazemUf             String?
  armazemCidade         String?
  armazemEndereco       String?
  coletaDiretaLavoura   Boolean?          @default(false)
  armazemId             String?
  terminalTransbordo    String?
  laudoClassificacao    String?
  distanciaRodoviariaKm Int?
  emissaoCO2EstimadaKg  Decimal?        @db.Decimal(10, 2)

  @@index([deadlineEmbarque])
  @@index([statusCache])
  @@index([produtorId])
  @@index([importadorId])
}

// ---------------------------------------------------------------------------
// CONTÊINERES
// ---------------------------------------------------------------------------
model Container {
  id                     String       @id @default(cuid())
  processoId             String
  processo               Processo     @relation(fields: [processoId], references: [id], onDelete: Cascade)
  ordem                  Int
  numeroContainer        String?
  lacre                  String?
  pesoBruto              Decimal?     @db.Decimal(12, 3)
  pesoLiquido            Decimal?     @db.Decimal(12, 3)
  totalSacos             Int?
  tara                   Decimal?     @db.Decimal(12, 3)
  atualizadoEm           DateTime     @updatedAt

  notasFiscaisExportacao NotaFiscal[]

  @@unique([processoId, ordem])
}

// ---------------------------------------------------------------------------
// GED — DOCUMENTOS
// ---------------------------------------------------------------------------
enum CategoriaDocumento {
  COMERCIAL
  ADMINISTRATIVO
  PRODUCAO_INDUSTRIA
  BOOKING_TRANSPORTE
  REDEX_CARREGAMENTO
  DOCUMENTACAO_EXPORTACAO
  FECHAMENTO_BANCARIO
  ETIQUETA
  OUTRO
}

model TipoDocumento {
  id                       String             @id @default(cuid())
  nome                     String             @unique
  categoria                CategoriaDocumento
  obrigatorioNoPacoteFinal Boolean            @default(false)

  etapasQueGeram           EtapaTemplate[]
  documentos               Documento[]
}

enum StatusDocumento {
  RASCUNHO
  APROVADO
  ENVIADO_CLIENTE
  ARQUIVADO
  REPROVADO
}

model Documento {
  id                String          @id @default(cuid())
  processoId        String
  processo          Processo        @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipoDocumentoId   String
  tipoDocumento     TipoDocumento   @relation(fields: [tipoDocumentoId], references: [id])
  etapaOrigemId     String?
  etapaOrigem       ProcessoEtapa?  @relation(fields: [etapaOrigemId], references: [id])
  parceiroEmissorId String?
  parceiroEmissor   Parceiro?       @relation(fields: [parceiroEmissorId], references: [id])

  nomeArquivo       String
  storagePath       String
  versao            Int             @default(1)
  status            StatusDocumento @default(RASCUNHO)

  uploadedById      String
  uploadedBy        Usuario         @relation("DocumentoUploadedBy", fields: [uploadedById], references: [id])
  uploadedEm        DateTime        @default(now())

  descricaoOutro    String?
  @@index([processoId, tipoDocumentoId])
}

// ---------------------------------------------------------------------------
// FINANCEIRO & TRAVAMENTOS CAMBIAIS (Atualizado)
// ---------------------------------------------------------------------------
model Financeiro {
  id              String          @id @default(cuid())
  processoId      String          @unique
  processo        Processo        @relation(fields: [processoId], references: [id], onDelete: Cascade)
  
  // Preço base unitário em USD da negociação
  precoUsd        Decimal         @db.Decimal(12, 2)
  
  // Banco de destino principal do contrato (Ex: "BB BRASIL" ou "BB AMERICA")
  bancoDestino    String?         @default("BB BRASIL")

  statusRecebimento String        @default("A_RECEBER") // "A_RECEBER" ou "RECEBIDO"
  dataRecebimento   DateTime?     // Data efetiva em que o pagamento foi recebido
  
  // Lista de travamentos de câmbio (Pode ser total ou vários parciais)
  travamentos     CambioTravado[]
  
  // Custos operacionais do processo
  custos          CustoItem[]
  
  atualizadoEm    DateTime        @updatedAt
}

model CambioTravado {
  id              String      @id @default(cuid())
  financeiroId    String
  financeiro      Financeiro  @relation(fields: [financeiroId], references: [id], onDelete: Cascade)
  
  valorUsdParcial Decimal     @db.Decimal(14, 2) // Quantos USD foram travados neste lote
  ptax            Decimal     @db.Decimal(16, 7) // Taxa PTAX do travamento com até 7 casas decimais (ex: 5.1500727)
  taxa            Decimal?    @default(0) @db.Decimal(12, 2) // Taxa cobrada na operação
  moedaTaxa       String?     @default("USD")    // "USD" ou "BRL"
  valorLiquido    Decimal?    @db.Decimal(14, 2) // Valor líquido em R$ após deduzir taxa
  dataTravamento  DateTime    @default(now())    // Data em que a trava foi realizada
  observacao      String?     // Ex: "Parcial referente a 50% do BL"
  
  atualizadoEm    DateTime    @updatedAt
}

enum CategoriaCusto {
  // ---- ANTIGOS (Mantidos apenas para não quebrar o banco de dados) ----
  COMPRA_MATERIA_PRIMA
  ESTUFAGEM_REDEX
  COMISSAO_INTERMEDIACAO
  OUTROS

  // ---- NOVOS (Estes são os que a Bela Cereais vai usar na tela) ----
  COMPRA
  BENEFICIAMENTO
  SACARIA
  FRETE_TERRESTRE
  FRETE_MARITIMO
  TARIFA_ARMADOR_PORTO
  SERVICO_ESTUFF
  COMISSAO
  OUTROS_CUSTOS
}

model CustoItem {
  id              String         @id @default(cuid())
  financeiroId    String
  financeiro      Financeiro     @relation(fields: [financeiroId], references: [id], onDelete: Cascade)
  categoria       CategoriaCusto
  valor           Decimal        @db.Decimal(14, 2)
  atualizadoPorId String
  atualizadoPor   Usuario        @relation(fields: [atualizadoPorId], references: [id])
  atualizadoEm    DateTime       @updatedAt

  @@unique([financeiroId, categoria])
}

// ---------------------------------------------------------------------------
// CHAT INTERNO
// ---------------------------------------------------------------------------
model ChatMessage {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  autorId    String
  autor      Usuario  @relation(fields: [autorId], references: [id])
  texto      String
  criadoEm   DateTime @default(now())

  @@index([processoId, criadoEm])
}

// ---------------------------------------------------------------------------
// AUDITORIA
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  processoId String
  processo   Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  acao       String
  detalhe    String
  alteracoes Json?
  criadoEm   DateTime @default(now())

  @@index([processoId, criadoEm])
}

// ---------------------------------------------------------------------------
// LOG DE WEBHOOKS N8N
// ---------------------------------------------------------------------------
model WebhookEvent {
  id         String   @id @default(cuid())
  origem     String
  evento     String
  payload    Json
  processado Boolean  @default(false)
  erro       String?
  recebidoEm DateTime @default(now())
}

// ---------------------------------------------------------------------------
// MÓDULO: NOTAS FISCAIS (TRIANGULAÇÃO FISCAL & AVERBAÇÃO DE EXPORTAÇÃO)
// ---------------------------------------------------------------------------

enum EtapaNotaFiscal {
  ETAPA_1_ENTRADA_INDUSTRIA
  ETAPA_2_RETORNO_ARMAZENAGEM
  ETAPA_3_REMESSA_REDEX
  ETAPA_4_EXPORTACAO
}

enum StatusSefaz {
  AUTORIZADA
  PENDENTE
  CANCELADA
  DENEGADA
}

enum StatusAverbacao {
  AGUARDANDO
  PENDENTE_AVERBACAO
  AVERBADA
  REJEITADA
}

model NotaFiscal {
  id                String          @id @default(cuid())
  processoId        String
  processo          Processo        @relation(fields: [processoId], references: [id], onDelete: Cascade)
  etapa             EtapaNotaFiscal
  numero            String
  serie             String?         @default("1")
  chaveAcesso       String?         // 44 dígitos
  dataEmissao       DateTime
  emitente          String
  emitenteCnpj      String?
  destinatario      String
  destinatarioCnpj  String?
  cfop              String?
  pesoBruto         Decimal?        @db.Decimal(14, 3)
  pesoLiquido       Decimal         @db.Decimal(14, 3)
  quantidadeSacas   Int?
  valorTotal        Decimal?        @db.Decimal(14, 2)
  anexoUrl          String?
  anexoNome         String?

  // Controle de Saldo da Etapa 3 (Formação de Lote REDEX)
  saldoDisponivelKg Decimal?        @db.Decimal(14, 3)
  saldoZerado       Boolean         @default(false)

  // Vínculo Obrigatório com Contêiner (Etapa 4)
  containerId       String?
  container         Container?      @relation(fields: [containerId], references: [id], onDelete: SetNull)

  // Integração SEFAZ & Averbação (Etapa 4)
  statusSefaz       StatusSefaz     @default(AUTORIZADA)
  protocoloSefaz    String?
  dataConsultaSefaz DateTime?
  mensagemSefaz     String?
  statusAverbacao   StatusAverbacao @default(AGUARDANDO)
  dataAverbacao     DateTime?
  numeroDue         String?         // DUE vinculada à exportação

  // Relações Etapa 2 <-> Etapa 1
  retornosComoOrigem NotaFiscalRetornoItem[] @relation("NotaRetorno")
  entradasReferenciadas NotaFiscalRetornoItem[] @relation("NotaEntrada")

  // Relações Etapa 4 <-> Etapa 3 (Até 3 NFs Etapa 3 por contêiner)
  itensExportacao    NotaFiscalExportacaoItem[] @relation("NotaExportacao")
  consumosEmExportacao NotaFiscalExportacaoItem[] @relation("NotaLoteRedex")

  observacoes       String?
  criadoEm          DateTime        @default(now())
  atualizadoEm      DateTime        @updatedAt

  @@index([processoId, etapa])
  @@index([chaveAcesso])
}

model NotaFiscalRetornoItem {
  id              String      @id @default(cuid())
  notaRetornoId   String
  notaRetorno     NotaFiscal  @relation("NotaRetorno", fields: [notaRetornoId], references: [id], onDelete: Cascade)
  notaEntradaId   String
  notaEntrada     NotaFiscal  @relation("NotaEntrada", fields: [notaEntradaId], references: [id], onDelete: Cascade)
  pesoRetornadoKg Decimal?    @db.Decimal(14, 3)
  criadoEm        DateTime    @default(now())

  @@unique([notaRetornoId, notaEntradaId])
}

model NotaFiscalExportacaoItem {
  id              String      @id @default(cuid())
  notaExportacaoId String
  notaExportacao  NotaFiscal  @relation("NotaExportacao", fields: [notaExportacaoId], references: [id], onDelete: Cascade)
  notaLoteRedexId String
  notaLoteRedex   NotaFiscal  @relation("NotaLoteRedex", fields: [notaLoteRedexId], references: [id], onDelete: Cascade)
  pesoConsumidoKg Decimal     @db.Decimal(14, 3)
  criadoEm        DateTime    @default(now())

  @@unique([notaExportacaoId, notaLoteRedexId])
}

// ---------------------------------------------------------------------------
// CENTRAL DE CADASTROS: PRODUTORES, IMPORTADORES & BUYERS
// ---------------------------------------------------------------------------
enum TipoEntidadeComercial {
  PRODUTOR
  IMPORTADOR
  BUYER
  ARMAZEM
}

model CadastroEntidade {
  id                String                 @id @default(cuid())
  tipo              TipoEntidadeComercial  @default(IMPORTADOR)
  razaoSocial       String
  nomeFantasia      String?
  documento         String?                // CNPJ, CPF ou Tax ID

  // Rastreabilidade do Grão & Dados do Produtor Rural
  inscricaoEstadual String?                // Inscrição Estadual (IE)
  carNumero         String?                // Cadastro Ambiental Rural (CAR)
  nomePropriedade   String?                // Fazenda / Gleba de Origem
  municipio         String?
  uf                String?
  coordenadasGps    String?                // Latitude, Longitude (ex: -11.8542, -51.1823)
  areaTotalHectares Decimal?               @db.Decimal(12, 2)
  certificacoes     String?                // Ex: RTRS, ProTerra, Não-Transgênico
  conformidadeSocioambiental Boolean?      @default(true)

  // Dados Comuns & Internacionais (Importador / Buyer)
  pais              String?                @default("Brasil")
  cidade            String?
  endereco          String?
  complemento       String?
  codigoPostal      String?
  email             String?
  telefone          String?
  iecTaxId          String?                // IEC (Import Export Code)
  fassaiId          String?                // FASSAI
  panId             String?                // PAN
  gstId             String?                // GST

  // Informações Bancárias do Destino
  bancoNome         String?
  bancoEndereco     String?
  bancoConta        String?
  bancoSwift        String?
  bancoEmail        String?
  bancoTelefone     String?

  observacoes       String?
  ativo             Boolean                @default(true)
  criadoEm          DateTime               @default(now())
  atualizadoEm      DateTime               @updatedAt

  processosComoProdutor   Processo[] @relation("ProcessoProdutor")
  processosComoImportador Processo[] @relation("ProcessoImportador")

  @@index([tipo])
  @@index([razaoSocial])
  @@index([carNumero])
  @@index([documento])
}